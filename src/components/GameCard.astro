---
import { gameStatuses, type Game } from "@/constants/games"
import GamePreview from "./GamePreview.astro"
import GameStatusBadge from "./GameStatusBadge.astro"

interface Props {
    game: Game
}

const { game } = Astro.props
const isPlayable = game.status === "playable"
const status = gameStatuses[game.status]
---

<a
    href={game.path}
    class="game-card"
    style={`--preview-accent: ${game.accent}; --preview-soft: ${game.accentSoft}; --card-accent: ${game.accent};`}
    aria-label={status.actionAriaLabel(game.title)}
>
    <div class="game-card__preview">
        <GamePreview gameId={game.id} />
        <div class="game-card__status"><GameStatusBadge status={game.status} /></div>
    </div>

    <div class="game-card__body">
        <div class="game-card__heading">
            <h3>{game.title}</h3>
            <span>{game.category}</span>
        </div>
        <p>{game.description}</p>
        <div class="game-card__footer">
            <span class="game-card__time">{game.session}</span>
            <span class={`game-card__action ${!isPlayable ? "is-muted" : ""}`}>
                {status.actionLabel}
                <i aria-hidden="true">→</i>
            </span>
        </div>
    </div>
</a>

<style>
    .game-card {
        display: flex;
        height: 100%;
        overflow: hidden;
        flex-direction: column;
        border: 1px solid var(--arcade-border);
        border-radius: var(--radius-lg);
        background: var(--arcade-surface);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.16);
        transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
    }

    .game-card:hover {
        border-color: color-mix(in srgb, var(--card-accent) 60%, var(--arcade-border));
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.3), 0 0 22px color-mix(in srgb, var(--card-accent) 9%, transparent);
        transform: translateY(-4px);
    }

    .game-card__preview {
        position: relative;
        min-height: 12.5rem;
        overflow: hidden;
        border-bottom: 1px solid var(--arcade-border);
    }

    .game-card__preview::after {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--card-accent), transparent);
        content: "";
        opacity: 0.7;
    }

    .game-card__preview :global(.game-preview) {
        min-height: 12.5rem;
        padding-top: 2rem;
    }

    .game-card__status {
        position: absolute;
        top: 0.2rem;
        left: 0.8rem;
        z-index: 2;
        pointer-events: none;
    }

    .game-card__body {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 1.25rem;
    }

    .game-card__heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.65rem;
    }

    h3 {
        margin-bottom: 0;
        color: #fff;
        font-size: 1.25rem;
        font-weight: 750;
        letter-spacing: -0.035em;
        line-height: 1.2;
    }

    .game-card__heading > span {
        flex: 0 0 auto;
        color: var(--arcade-subtle);
        font-family: var(--font-utility);
        font-size: 0.58rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    p {
        margin-bottom: 1.35rem;
        color: var(--arcade-muted);
        font-size: 0.86rem;
        line-height: 1.55;
    }

    .game-card__footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-top: auto;
        padding-top: 0.9rem;
        border-top: 1px solid var(--arcade-border);
    }

    .game-card__time {
        color: var(--arcade-subtle);
        font-family: var(--font-utility);
        font-size: 0.62rem;
        text-transform: uppercase;
    }

    .game-card__action {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #fff;
        font-size: 0.78rem;
        font-weight: 750;
    }

    .game-card__action i {
        color: var(--card-accent);
        font-size: 1rem;
        font-style: normal;
        transition: transform 180ms ease;
    }

    .game-card:hover .game-card__action i {
        transform: translateX(3px);
    }

    .game-card__action.is-muted {
        color: var(--arcade-muted);
    }
</style>
