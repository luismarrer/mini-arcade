---
import { gameStatuses, type Game } from "@/constants/games";
import GamePreview from "./GamePreview.astro";
import GameStatusBadge from "./GameStatusBadge.astro";

interface Props {
    game: Game;
}

const { game } = Astro.props;
const isPlayable = game.status === "playable";
const status = gameStatuses[game.status];
---

<a
    href={game.path}
    class="group flex flex-col h-full overflow-hidden border border-arcade-border rounded-[1.35rem] bg-arcade-surface shadow-[0_12px_30px_rgba(0,0,0,0.16)] transition-all duration-200 hover:-translate-y-1 hover:border-[var(--card-accent)] hover:shadow-[0_18px_45px_rgba(0,0,0,0.3),0_0_28px_color-mix(in_srgb,var(--card-accent)_18%,transparent)]"
    style={`--preview-accent: ${game.accent}; --preview-soft: ${game.accentSoft}; --card-accent: ${game.accent};`}
    aria-label={status.actionAriaLabel(game.title)}
>
    <div
        class="relative h-[12.5rem] min-h-[12.5rem] flex-none overflow-hidden border-b border-arcade-border [--game-preview-safe-block-start:2rem] [--game-preview-safe-block-end:0.75rem] [--game-preview-safe-inline:0.75rem] [--game-preview-min-height:0] after:absolute after:inset-x-0 after:bottom-0 after:h-[2px] after:bg-gradient-to-r after:from-transparent after:via-[var(--card-accent)] after:to-transparent after:opacity-70"
    >
        <GamePreview gameId={game.id} />
        <div
            class="absolute top-[0.2rem] left-[0.8rem] z-10 pointer-events-none"
        >
            <GameStatusBadge status={game.status} />
        </div>
    </div>

    <div class="flex flex-col flex-1 p-5">
        <div class="flex items-baseline justify-between gap-4 mb-2.5">
            <h3
                class="mb-0 text-white text-[1.25rem] font-[750] tracking-[-0.035em] leading-snug"
            >
                {game.title}
            </h3>
            <span
                class="flex-none text-arcade-subtle font-utility text-[0.58rem] tracking-wider uppercase"
                >{game.category}</span
            >
        </div>
        <p class="mb-5.5 text-arcade-muted text-[0.86rem] leading-relaxed">
            {game.description}
        </p>
        <div
            class="flex items-center justify-between gap-4 mt-auto pt-3.5 border-t border-arcade-border"
        >
            <span
                class="text-arcade-subtle font-utility text-[0.62rem] uppercase"
                >{game.session}</span
            >
            <span
                class={`inline-flex items-center gap-2 font-[750] text-[0.78rem] ${!isPlayable ? "text-arcade-muted" : "text-white"}`}
            >
                {status.actionLabel}
                <i
                    aria-hidden="true"
                    class="not-italic text-[1rem] text-[var(--card-accent)] transition-transform duration-200 group-hover:translate-x-1"
                    >→</i
                >
            </span>
        </div>
    </div>
</a>
