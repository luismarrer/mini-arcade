---
interface Props {
    gameId: string
}

const { gameId } = Astro.props
---

<div class={`game-preview game-preview--${gameId}`} aria-hidden="true">
    {gameId === "memory" && (
        <div class="memory-grid">
            {["●", "▲", "■", "●", "✦", "■", "▲", "✦"].map((mark, index) => (
                <span class={index === 0 || index === 3 ? "is-up" : ""}>{mark}</span>
            ))}
        </div>
    )}
    {gameId === "twodots" && (
        <div class="dots-grid">
            {Array.from({ length: 16 }).map((_, index) => (
                <span class={index === 5 || index === 6 || index === 10 ? "is-linked" : ""} />
            ))}
        </div>
    )}
    {gameId === "hexapawn" && (
        <div class="pawn-grid">
            {["♟", "♟", "♟", "", "♙", "", "♙", "", "♙"].map((piece) => <span>{piece}</span>)}
        </div>
    )}
    {gameId === "hangman" && (
        <div class="hangman-drawing">
            <i class="beam" /><i class="rope" /><i class="head" /><i class="body" />
            <span>_ A _ E</span>
        </div>
    )}
    {gameId === "stack" && (
        <div class="stack-preview"><span /><span /><span /><span /><span /></div>
    )}
    {gameId === "monkeytype" && (
        <div class="type-preview">
            <span>const practice =</span>
            <span><b>"one more game"</b><i /></span>
        </div>
    )}
    {gameId === "tetris" && (
        <div class="tetris-preview">
            {Array.from({ length: 20 }).map((_, index) => <span class={`block-${index}`} />)}
        </div>
    )}
</div>

<style>
    .game-preview {
        position: relative;
        display: grid;
        width: 100%;
        height: 100%;
        min-height: 12rem;
        place-items: center;
        overflow: hidden;
        color: #f8f5fb;
        background:
            radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--preview-accent, #8b2cff) 22%, transparent), transparent 55%),
            var(--preview-soft, #16101f);
    }

    .game-preview::before {
        position: absolute;
        inset: 0;
        content: "";
        pointer-events: none;
        background:
            linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
        background-size: 20px 20px;
        mask-image: linear-gradient(to bottom, black, transparent 92%);
    }

    .game-preview::after {
        position: absolute;
        inset: 0;
        content: "";
        pointer-events: none;
        background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(255, 255, 255, 0.018) 3px 4px);
    }

    .memory-grid {
        position: relative;
        z-index: 1;
        display: grid;
        width: min(67%, 13rem);
        grid-template-columns: repeat(4, 1fr);
        gap: 0.42rem;
        perspective: 800px;
    }

    .memory-grid span {
        display: grid;
        aspect-ratio: 0.76;
        place-items: center;
        border: 1px solid #594660;
        border-radius: 0.35rem;
        color: transparent;
        background: linear-gradient(145deg, #382246, #21152d);
        box-shadow: 0 7px 14px rgba(0, 0, 0, 0.28);
        font-size: 0.9rem;
    }

    .memory-grid .is-up {
        border-color: #f4c430;
        color: #1c1424;
        background: #f4c430;
        transform: rotateY(180deg);
    }

    .dots-grid {
        position: relative;
        z-index: 1;
        display: grid;
        width: min(58%, 11rem);
        grid-template-columns: repeat(4, 1fr);
        gap: 0.95rem;
    }

    .dots-grid span {
        aspect-ratio: 1;
        border: 3px solid rgba(255, 255, 255, 0.75);
        border-radius: 50%;
        background: #fd315b;
        box-shadow: 0 0 12px rgba(253, 49, 91, 0.3);
    }

    .dots-grid span:nth-child(2n) {
        background: #72cf4d;
        box-shadow: 0 0 12px rgba(114, 207, 77, 0.25);
    }

    .dots-grid .is-linked {
        outline: 2px solid #fff;
        outline-offset: 3px;
        transform: scale(1.08);
    }

    .pawn-grid {
        position: relative;
        z-index: 1;
        display: grid;
        width: min(58%, 11rem);
        overflow: hidden;
        grid-template-columns: repeat(3, 1fr);
        border: 2px solid #00ff41;
        border-radius: 0.35rem;
        box-shadow: 0 0 20px rgba(0, 255, 65, 0.18);
    }

    .pawn-grid span {
        display: grid;
        aspect-ratio: 1;
        place-items: center;
        border: 1px solid #25422b;
        color: #00ff41;
        background: #0d1410;
        font-size: clamp(1.05rem, 3vw, 1.75rem);
        text-shadow: 0 0 8px rgba(0, 255, 65, 0.55);
    }

    .pawn-grid span:nth-child(even) { background: #152019; }
    .pawn-grid span:nth-child(-n + 3) { color: #ff7445; text-shadow: 0 0 8px rgba(255, 116, 69, 0.5); }

    .hangman-drawing {
        position: relative;
        z-index: 1;
        width: min(66%, 13rem);
        height: 8rem;
        border-bottom: 3px solid #3b82f6;
        filter: drop-shadow(0 0 7px rgba(59, 130, 246, 0.45));
    }

    .hangman-drawing i {
        position: absolute;
        display: block;
        background: #3b82f6;
    }

    .hangman-drawing .beam { top: 0; left: 1rem; width: 6rem; height: 3px; }
    .hangman-drawing .beam::before { position: absolute; width: 3px; height: 6.8rem; background: #3b82f6; content: ""; }
    .hangman-drawing .rope { top: 0; left: 6.7rem; width: 2px; height: 1.5rem; }
    .hangman-drawing .head { top: 1.35rem; left: 5.85rem; width: 1.85rem; height: 1.85rem; border: 3px solid #3b82f6; border-radius: 50%; background: transparent; }
    .hangman-drawing .body { top: 3.1rem; left: 6.65rem; width: 3px; height: 2.8rem; }

    .hangman-drawing span {
        position: absolute;
        right: -0.7rem;
        bottom: 0.2rem;
        color: #c8dcff;
        font-family: var(--font-utility);
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.12em;
    }

    .stack-preview {
        position: relative;
        z-index: 1;
        display: flex;
        width: min(70%, 13rem);
        flex-direction: column-reverse;
        align-items: center;
        gap: 0.25rem;
    }

    .stack-preview span {
        width: 100%;
        height: 1.3rem;
        border-radius: 0.18rem;
        background: #e5454b;
        box-shadow: 0 5px 12px rgba(0, 0, 0, 0.25);
    }

    .stack-preview span:nth-child(2) { width: 84%; background: #f4c430; }
    .stack-preview span:nth-child(3) { width: 68%; background: #82dc3d; }
    .stack-preview span:nth-child(4) { width: 52%; background: #2387c4; }
    .stack-preview span:nth-child(5) { width: 36%; background: #9b5cff; transform: translateX(0.8rem); }

    .type-preview {
        position: relative;
        z-index: 1;
        width: min(78%, 18rem);
        padding: 1.1rem;
        border: 1px solid #5e4575;
        border-radius: 0.45rem;
        color: #c7b7d5;
        background: #15101d;
        box-shadow: 0 14px 26px rgba(0, 0, 0, 0.25);
        font-family: var(--font-utility);
        font-size: clamp(0.68rem, 2vw, 0.86rem);
        line-height: 1.8;
    }

    .type-preview span { display: block; white-space: nowrap; }
    .type-preview b { color: #b783ff; font-weight: 600; }
    .type-preview i { display: inline-block; width: 0.5rem; height: 1rem; margin-left: 0.25rem; background: #f4c430; vertical-align: middle; animation: blink 1s steps(1) infinite; }

    .tetris-preview {
        position: relative;
        z-index: 1;
        display: grid;
        width: min(50%, 9.5rem);
        grid-template-columns: repeat(4, 1fr);
        gap: 0.13rem;
        padding: 0.3rem;
        border: 2px solid #22b8cf;
        background: #0c1820;
        box-shadow: 0 0 20px rgba(34, 184, 207, 0.18);
    }

    .tetris-preview span { aspect-ratio: 1; border: 1px solid rgba(255, 255, 255, 0.05); background: #1e3541; }
    .tetris-preview .block-2,
    .tetris-preview .block-6,
    .tetris-preview .block-9,
    .tetris-preview .block-10,
    .tetris-preview .block-13,
    .tetris-preview .block-14,
    .tetris-preview .block-15,
    .tetris-preview .block-16,
    .tetris-preview .block-17,
    .tetris-preview .block-18,
    .tetris-preview .block-19 { background: #22b8cf; }
    .tetris-preview .block-10,
    .tetris-preview .block-14 { background: #e5454b; }

    @keyframes blink { 50% { opacity: 0; } }
</style>
