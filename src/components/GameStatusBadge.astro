---
import { gameStatuses, type GameStatus } from "@/constants/games"

interface Props {
    status: GameStatus
}

const { status } = Astro.props
const details = gameStatuses[status]

const statusStyles: Record<GameStatus, string> = {
    playable: "border-[#528a37] text-[#bff58f]",
    "in-development": "border-[#957523] text-[#ffe082]",
    planned: "border-[#68577a] text-[#cbbbd8]",
}
---

<span
    class={`inline-flex min-h-[1.75rem] items-center px-2.5 py-1 border ${statusStyles[status]} rounded-full bg-[#0d0912]/90 backdrop-blur-md font-utility text-[0.58rem] font-semibold tracking-wider uppercase whitespace-nowrap`}
    title={details.description}
>
    {details.label}
</span>
