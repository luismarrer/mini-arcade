<section class="overflow-hidden border border-[#493d5d] rounded-[0.8rem] text-[#d9d3df] bg-[#141118] shadow-[0_24px_55px_rgba(0,0,0,0.35)] font-utility" aria-labelledby="typing-status">
    <header class="flex min-h-[2.9rem] items-center justify-between gap-4 py-[0.7rem] px-4 border-b border-[#332b3d] text-[#81758e] bg-[#1c1722] text-[0.68rem]">
        <span>monkeytype_prototype.ts</span>
        <span class="hidden min-[701px]:inline text-arcade-yellow">not playable yet</span>
    </header>

    <div class="min-h-[17rem] min-[701px]:min-h-[22rem] p-[clamp(1.5rem,5vw,4rem)] bg-[#141118] [background-image:radial-gradient(circle_at_80%_0%,rgba(155,92,255,0.12),transparent_24rem)]" aria-hidden="true">
        <div class="flex gap-[1.4rem] mb-[clamp(2.8rem,7vw,5rem)] text-[#786d84] text-[0.7rem]">
            <span><b class="block text-[#b783ff] text-[1.35rem] font-normal">00</b> wpm</span>
            <span><b class="block text-[#b783ff] text-[1.35rem] font-normal">100</b> acc</span>
            <span><b class="block text-[#b783ff] text-[1.35rem] font-normal">30</b> sec</span>
        </div>
        <p class="max-w-[58rem] text-[#4e4656] text-[clamp(1.35rem,4vw,2.7rem)] leading-[1.45] tracking-[-0.035em]">
            <span class="mr-[0.35em] text-[#a49aaa]">small games are where ideas learn to move</span>
            <span class="relative mr-[0.35em] text-[#e6e1ea] after:absolute after:top-[0.12em] after:-right-[0.18em] after:w-[2px] after:h-[1.05em] after:bg-arcade-yellow after:animate-caret-blink motion-reduce:after:animate-none">one</span>
            <span class="mr-[0.35em]">keystroke at a time</span>
        </p>
        <div class="hidden min-[701px]:flex max-w-[42rem] flex-wrap gap-[0.35rem] mt-12 opacity-[0.72]">
            {['q','w','e','r','t','y','u','i','o','p','a','s','d','f','g','h','j','k','l'].map((key) => (
                <kbd class="grid w-8 h-8 place-items-center border border-[#403648] rounded-[0.3rem] text-[#988da2] bg-[#211b27] text-[0.68rem] shadow-[0_2px_0_#09070b]">{key}</kbd>
            ))}
        </div>
    </div>

    <footer class="grid grid-cols-1 min-[701px]:grid-cols-[minmax(0,1.15fr)_minmax(15rem,0.85fr)] gap-8 items-end p-[clamp(1.35rem,4vw,2.4rem)] border-t border-[#332b3d] bg-[#1a151f]">
        <div>
            <p class="mb-2 text-[#b783ff] text-[0.68rem] tracking-wider uppercase">Typing prototype / 25%</p>
            <h2 id="typing-status" class="m-0 text-[#f4f0f7] font-body text-[clamp(1.6rem,4vw,2.6rem)] leading-[1.06] tracking-[-0.04em]">I’m working on the rhythm before the scoreboard.</h2>
        </div>
        <p class="m-0 text-[#9c91a4] text-[0.78rem] leading-[1.75]">
            The next pass is about accurate word timing, keyboard-first focus and
            feedback that stays out of the way while you type.
        </p>
    </footer>
</section>
