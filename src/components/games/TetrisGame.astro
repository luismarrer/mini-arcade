<section class="grid grid-cols-1 md:grid-cols-[minmax(17rem,0.82fr)_minmax(0,1.18fr)] gap-[clamp(1.2rem,4vw,3.5rem)] items-center p-[clamp(1rem,4vw,3rem)] border border-[#184b59] rounded-xl text-[#dff9ff] bg-[#07151b] [background-image:linear-gradient(rgba(34,184,207,0.035)_1px,transparent_1px),linear-gradient(90deg,rgba(34,184,207,0.035)_1px,transparent_1px)] [background-size:24px_24px]" aria-labelledby="tetris-status">
    <div class="relative w-[min(100%,21rem)] justify-self-center p-7 pt-7 px-4 pb-4 border-2 border-[#22b8cf] bg-[#071117] shadow-[0_0_32px_rgba(34,184,207,0.18),inset_0_0_24px_rgba(0,0,0,0.55)]" aria-hidden="true">
        <div class="grid grid-cols-8 border border-[#17343d]">
            {Array.from({ length: 80 }).map((_, index) => <span class="aspect-square border border-[rgba(34,184,207,0.065)]"></span>)}
        </div>
        <div class="absolute right-[18%] bottom-[14%] grid grid-cols-2 w-10 rotate-90">
            <i class="aspect-square border border-white/40 bg-[#22b8cf] shadow-[inset_1px_1px_0_rgba(255,255,255,0.28),inset_-1px_-1px_0_rgba(0,0,0,0.22)]"></i>
            <i class="aspect-square border border-white/40 bg-[#22b8cf] shadow-[inset_1px_1px_0_rgba(255,255,255,0.28),inset_-1px_-1px_0_rgba(0,0,0,0.22)]"></i>
            <i class="aspect-square border border-white/40 bg-[#22b8cf] shadow-[inset_1px_1px_0_rgba(255,255,255,0.28),inset_-1px_-1px_0_rgba(0,0,0,0.22)]"></i>
            <i class="aspect-square border border-white/40 bg-[#22b8cf] shadow-[inset_1px_1px_0_rgba(255,255,255,0.28),inset_-1px_-1px_0_rgba(0,0,0,0.22)]"></i>
        </div>
        <div class="absolute left-[21%] bottom-[8%] grid grid-cols-2 w-10 -rotate-90">
            <i class="aspect-square border border-white/40 bg-[#e5454b] shadow-[inset_1px_1px_0_rgba(255,255,255,0.28),inset_-1px_-1px_0_rgba(0,0,0,0.22)]"></i>
            <i class="aspect-square border border-white/40 bg-[#e5454b] shadow-[inset_1px_1px_0_rgba(255,255,255,0.28),inset_-1px_-1px_0_rgba(0,0,0,0.22)]"></i>
            <i class="aspect-square border border-white/40 bg-[#e5454b] shadow-[inset_1px_1px_0_rgba(255,255,255,0.28),inset_-1px_-1px_0_rgba(0,0,0,0.22)]"></i>
            <i class="aspect-square border border-white/40 bg-[#e5454b] shadow-[inset_1px_1px_0_rgba(255,255,255,0.28),inset_-1px_-1px_0_rgba(0,0,0,0.22)]"></i>
        </div>
        <div class="absolute left-[40%] bottom-[3.5%] grid grid-cols-2 w-10">
            <i class="aspect-square border border-white/40 bg-[#f4c430] shadow-[inset_1px_1px_0_rgba(255,255,255,0.28),inset_-1px_-1px_0_rgba(0,0,0,0.22)]"></i>
            <i class="aspect-square border border-white/40 bg-[#f4c430] shadow-[inset_1px_1px_0_rgba(255,255,255,0.28),inset_-1px_-1px_0_rgba(0,0,0,0.22)]"></i>
            <i class="aspect-square border border-white/40 bg-[#f4c430] shadow-[inset_1px_1px_0_rgba(255,255,255,0.28),inset_-1px_-1px_0_rgba(0,0,0,0.22)]"></i>
            <i class="aspect-square border border-white/40 bg-[#f4c430] shadow-[inset_1px_1px_0_rgba(255,255,255,0.28),inset_-1px_-1px_0_rgba(0,0,0,0.22)]"></i>
        </div>
        <span class="absolute top-1.5 left-2 text-[#4c8794] font-utility text-[0.56rem] tracking-wider">BOARD TEST / 10 × 8</span>
    </div>

    <div>
        <p class="mb-[0.7rem] text-[#22b8cf] font-utility text-[0.68rem] font-semibold tracking-wider uppercase">Puzzle rebuild / queued</p>
        <h2 id="tetris-status" class="max-w-[36rem] mb-4 text-[clamp(2rem,5vw,3.6rem)] font-bold leading-none tracking-tight">The blocks are here. The rules are being wired up.</h2>
        <p class="max-w-[36rem] mb-0 text-[#8fb2ba]">
            This version is waiting on rotation, collision and line-clearing logic.
            Until those three feel right, it stays marked as a build instead of a game.
        </p>
        <ol class="my-6 p-0 border-y border-[#17343d] list-none">
            <li class="flex gap-3.5 py-[0.7rem] text-[#b9d5da] text-[0.82rem]">
                <span class="text-[#22b8cf] font-utility text-[0.7rem]">01</span> Rotation system
            </li>
            <li class="flex gap-3.5 py-[0.7rem] border-t border-[#102b33] text-[#b9d5da] text-[0.82rem]">
                <span class="text-[#22b8cf] font-utility text-[0.7rem]">02</span> Line + level scoring
            </li>
            <li class="flex gap-3.5 py-[0.7rem] border-t border-[#102b33] text-[#b9d5da] text-[0.82rem]">
                <span class="text-[#22b8cf] font-utility text-[0.7rem]">03</span> Keyboard and touch controls
            </li>
        </ol>
        <a href="/all-games" class="button button--secondary button--small">Back to game select</a>
    </div>
</section>
