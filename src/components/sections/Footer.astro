---
const year = new Date().getFullYear();
---

<footer class="py-7 pb-9">
    <div class="shell flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 pt-5 border-t border-arcade-border">
        <div class="flex items-center gap-3">
            <span class="flex gap-1" aria-hidden="true">
                <i class="w-1.5 h-1.5 rounded-full bg-arcade-red shadow-[0_0_8px_rgba(229,69,75,0.35)]"></i>
                <i class="w-1.5 h-1.5 rounded-full bg-arcade-yellow shadow-[0_0_8px_rgba(244,196,48,0.35)]"></i>
                <i class="w-1.5 h-1.5 rounded-full bg-arcade-green shadow-[0_0_8px_rgba(130,220,61,0.35)]"></i>
            </span>
            <p class="m-0 text-[0.72rem] text-arcade-subtle">
                <strong class="font-bold text-arcade-muted">Mini-Arcade</strong> · small browser games
            </p>
        </div>

        <nav class="flex flex-col sm:flex-row sm:items-center gap-[0.45rem] sm:gap-5 font-utility text-[0.72rem] tracking-wider text-arcade-subtle" aria-label="Footer navigation">
            <span>© {year} Luis Marrero</span>
            <a
                href="https://github.com/luismarrer/mini-arcade"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center text-arcade-muted transition-colors duration-150 hover:text-arcade-text"
            >
                GitHub ↗
            </a>
            <a
                href="https://cv.luismarrero.me/en"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center text-arcade-muted transition-colors duration-150 hover:text-arcade-text"
            >
                Portfolio ↗
            </a>
        </nav>
    </div>
</footer>
