---
import GameCard from "@components/GameCard.astro"
import GameStatusBadge from "@components/GameStatusBadge.astro"
import {
    catalogStatusOrder,
    gameStatuses,
    getGameCount,
    getGamesByStatus,
} from "@/constants/games"

interface Props {
    heading?: string
    intro?: string
    showHeader?: boolean
}

const defaultIntro = `${getGameCount("playable")} are ready to play. ${getGameCount("in-development")} are visible builds still in development.`

const {
    heading = "Choose a game",
    intro = defaultIntro,
    showHeader = true,
} = Astro.props

const gameGroups = catalogStatusOrder
    .map((status) => ({
        status,
        details: gameStatuses[status],
        games: getGamesByStatus(status),
    }))
    .filter((group) => group.games.length > 0)
---

<section
    id="games"
    class="shell pb-[clamp(4rem,8vw,7rem)]"
    aria-labelledby={showHeader ? "games-heading" : undefined}
    aria-label={showHeader ? undefined : "Games"}
>
    {showHeader && (
        <header class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_minmax(16rem,0.7fr)] gap-4 md:gap-[clamp(2rem,7vw,6rem)] items-end mb-10 pb-5.5 border-b border-arcade-border">
            <div>
                <span class="block mb-[0.45rem] text-arcade-purple-bright font-utility text-[0.65rem] font-semibold tracking-wider uppercase">Game select</span>
                <h2 id="games-heading" class="mb-0 text-white text-[clamp(2.15rem,5vw,3.7rem)] font-extrabold tracking-[-0.05em] leading-none">{heading}</h2>
            </div>
            <p class="mb-0 text-arcade-muted text-[0.95rem]">{intro}</p>
        </header>
    )}

    {gameGroups.map((group, groupIdx) => (
        <div class={groupIdx > 0 ? "mt-14" : ""}>
            <div class="flex items-end sm:items-center justify-between gap-4 mb-4">
                <h3 class="flex items-center gap-[0.55rem] m-0 text-arcade-text text-[0.95rem] font-bold">{group.details.groupLabel}</h3>
                <span class="text-arcade-subtle font-utility text-[0.62rem] tracking-wider uppercase text-right sm:text-left">{group.games.length} {group.details.countLabel}</span>
            </div>
            <ul class={`grid gap-4 m-0 p-0 list-none ${group.status === 'playable' ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3'}`}>
                {group.games.map((game) => <li class="min-w-0"><GameCard {game} /></li>)}
            </ul>
        </div>
    ))}

    <aside class="mt-14 pt-5 border-t border-arcade-border" aria-labelledby="status-guide-title">
        <h3 id="status-guide-title" class="mb-3.5 text-arcade-subtle font-utility text-[0.62rem] tracking-wider uppercase">Status guide</h3>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-4 m-0 p-0 list-none">
            {catalogStatusOrder.map((status) => (
                <li class="flex items-start gap-2.5 text-arcade-muted text-[0.72rem] leading-snug">
                    <GameStatusBadge {status} />
                    <span>{gameStatuses[status].description}</span>
                </li>
            ))}
        </ul>
    </aside>
</section>
