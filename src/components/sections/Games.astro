---
import GameCard from "@components/GameCard.astro"
import GameStatusBadge from "@components/GameStatusBadge.astro"
import {
    catalogStatusOrder,
    gameStatuses,
    getGameCount,
    getGamesByStatus,
} from "@/constants/games"

interface Props {
    heading?: string
    intro?: string
    showHeader?: boolean
}

const defaultIntro = `${getGameCount("playable")} are ready to play. ${getGameCount("in-development")} are visible builds still in development.`

const {
    heading = "Choose a game",
    intro = defaultIntro,
    showHeader = true,
} = Astro.props

const gameGroups = catalogStatusOrder
    .map((status) => ({
        status,
        details: gameStatuses[status],
        games: getGamesByStatus(status),
    }))
    .filter((group) => group.games.length > 0)
---

<section
    id="games"
    class="shell games-section"
    aria-labelledby={showHeader ? "games-heading" : undefined}
    aria-label={showHeader ? undefined : "Games"}
>
    {showHeader && (
        <header class="games-section__header">
            <div>
                <span class="section-label">Game select</span>
                <h2 id="games-heading">{heading}</h2>
            </div>
            <p>{intro}</p>
        </header>
    )}

    {gameGroups.map((group) => (
        <div class={`game-group game-group--${group.status}`}>
            <div class="game-group__heading">
                <h3>{group.details.groupLabel}</h3>
                <span>{group.games.length} {group.details.countLabel}</span>
            </div>
            <ul class={`games-grid games-grid--${group.status}`}>
                {group.games.map((game) => <li><GameCard {game} /></li>)}
            </ul>
        </div>
    ))}

    <aside class="status-guide" aria-labelledby="status-guide-title">
        <h3 id="status-guide-title">Status guide</h3>
        <ul>
            {catalogStatusOrder.map((status) => (
                <li>
                    <GameStatusBadge {status} />
                    <span>{gameStatuses[status].description}</span>
                </li>
            ))}
        </ul>
    </aside>
</section>

<style>
    .games-section {
        padding-bottom: clamp(4rem, 8vw, 7rem);
    }

    .games-section__header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.7fr);
        gap: clamp(2rem, 7vw, 6rem);
        align-items: end;
        margin-bottom: 2.5rem;
        padding-bottom: 1.4rem;
        border-bottom: 1px solid var(--arcade-border);
    }

    .section-label {
        display: block;
        margin-bottom: 0.45rem;
        color: var(--arcade-purple-bright);
        font-family: var(--font-utility);
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .games-section h2 {
        margin-bottom: 0;
        color: #fff;
        font-size: clamp(2.15rem, 5vw, 3.7rem);
        font-weight: 800;
        letter-spacing: -0.05em;
        line-height: 1;
    }

    .games-section__header p {
        margin-bottom: 0;
        color: var(--arcade-muted);
        font-size: 0.95rem;
    }

    .game-group + .game-group {
        margin-top: 3.5rem;
    }

    .game-group__heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .game-group__heading h3 {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin: 0;
        color: var(--arcade-text);
        font-size: 0.95rem;
        font-weight: 700;
    }

    .game-group__heading > span {
        color: var(--arcade-subtle);
        font-family: var(--font-utility);
        font-size: 0.62rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .games-grid {
        display: grid;
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .games-grid--playable {
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .games-grid--in-development,
    .games-grid--planned {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .status-guide {
        margin-top: 3.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--arcade-border);
    }

    .status-guide h3 {
        margin-bottom: 0.85rem;
        color: var(--arcade-subtle);
        font-family: var(--font-utility);
        font-size: 0.62rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .status-guide ul {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .status-guide li {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        color: var(--arcade-muted);
        font-size: 0.72rem;
        line-height: 1.45;
    }

    .games-grid li {
        min-width: 0;
    }

    @media (max-width: 960px) {
        .games-grid--playable,
        .games-grid--in-development,
        .games-grid--planned {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .status-guide ul {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 680px) {
        .games-section__header {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .games-grid--playable,
        .games-grid--in-development,
        .games-grid--planned {
            grid-template-columns: 1fr;
        }

        .game-group__heading {
            align-items: flex-end;
        }

        .game-group__heading > span {
            text-align: right;
        }
    }
</style>
