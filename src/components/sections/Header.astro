---
import AuthNav from "./AuthNav"

const pathname = Astro.url.pathname
---

<header class="pt-4">
    <div class="shell flex min-h-[4.4rem] flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 sm:gap-6 py-2.5 border-b border-arcade-border">
        <a href="/" class="inline-flex min-h-11 shrink-0 items-center gap-3" aria-label="Mini Arcade home">
            <img src="/favicon.svg" alt="" width="38" height="38" class="size-[2.4rem] rounded-[0.45rem] drop-shadow-[0_0_12px_rgba(244,196,48,0.2)]" />
            <span>
                <strong class="block text-white text-[0.98rem] font-extrabold tracking-tight leading-none">Mini Arcade</strong>
                <small class="block mt-1 text-arcade-subtle font-utility text-[0.56rem] tracking-widest uppercase leading-none">by Luis Marrero</small>
            </span>
        </a>

        <nav class="w-full sm:w-auto" aria-label="Primary navigation">
            <ul class="grid grid-cols-2 sm:flex sm:items-center gap-1.5 sm:gap-1.5 m-0 p-0 list-none w-full sm:w-auto">
                <li>
                    <a
                        href="/all-games"
                        aria-current={pathname === "/all-games" ? "page" : undefined}
                        class="inline-flex min-h-11 w-full sm:w-auto items-center justify-center px-3 py-2 border border-transparent rounded-lg text-arcade-muted text-[0.78rem] font-semibold transition-colors duration-150 hover:text-white hover:bg-white/5 aria-[current=page]:text-white aria-[current=page]:bg-white/5"
                    >
                        Games
                    </a>
                </li>
                <li>
                    <a
                        href="/about"
                        aria-current={pathname === "/about" ? "page" : undefined}
                        class="inline-flex min-h-11 w-full sm:w-auto items-center justify-center px-3 py-2 border border-transparent rounded-lg text-arcade-muted text-[0.78rem] font-semibold transition-colors duration-150 hover:text-white hover:bg-white/5 aria-[current=page]:text-white aria-[current=page]:bg-white/5"
                    >
                        About
                    </a>
                </li>
                <AuthNav client:load />
            </ul>
        </nav>
    </div>
</header>
