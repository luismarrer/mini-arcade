---
import { Image } from "astro:assets"
import Logo from "@/images/logo.png"
import { gameStatuses, getGameCount } from "@/constants/games"

const playableCount = getGameCount("playable")
const inDevelopmentCount = getGameCount("in-development")
---

<section class="shell py-[clamp(1.5rem,5vw,4.5rem)] pb-[clamp(3.5rem,7vw,6rem)]" aria-labelledby="hero-title">
    <div class="relative overflow-hidden border border-arcade-border-bright rounded-[1.4rem] bg-[#181222] [background-image:linear-gradient(135deg,rgba(35,135,196,0.28),transparent_48%),radial-gradient(circle_at_26%_47%,rgba(139,44,255,0.22),transparent_24rem)] shadow-[0_26px_80px_rgba(0,0,0,0.36)] after:absolute after:inset-0 after:pointer-events-none after:bg-[repeating-linear-gradient(0deg,transparent_0,transparent_3px,rgba(255,255,255,0.018)_3px,rgba(255,255,255,0.018)_4px)] after:mix-blend-screen">
        <div class="relative z-10 flex items-center justify-between gap-4 p-3 px-4 border-b border-arcade-border text-arcade-subtle bg-[rgba(7,5,11,0.35)] font-utility text-[0.62rem] tracking-wider" aria-hidden="true">
            <span>MINI_ARCADE.EXE</span>
            <span class="flex gap-1.5">
                <i class="w-[0.45rem] h-[0.45rem] rounded-full bg-arcade-red shadow-[0_0_10px_rgba(229,69,75,0.55)]"></i>
                <i class="w-[0.45rem] h-[0.45rem] rounded-full bg-arcade-yellow shadow-[0_0_10px_rgba(244,196,48,0.55)]"></i>
                <i class="w-[0.45rem] h-[0.45rem] rounded-full bg-arcade-green shadow-[0_0_10px_rgba(130,220,61,0.55)]"></i>
            </span>
        </div>

        <div class="relative z-10 grid grid-cols-1 min-[801px]:grid-cols-[minmax(17rem,0.8fr)_minmax(0,1.2fr)] gap-[1.2rem] min-[501px]:gap-[clamp(2rem,6vw,6rem)] items-center min-h-0 min-[801px]:min-h-[clamp(31rem,56vw,39rem)] p-[1.4rem] min-[501px]:p-[clamp(2rem,6vw,5rem)] text-center min-[801px]:text-left">
            <div class="relative grid place-items-center">
                <div class="absolute w-[min(90%,23rem)] aspect-square rounded-full bg-[radial-gradient(circle,rgba(244,196,48,0.25),rgba(35,135,196,0.09)_46%,transparent_70%)] blur-md animate-screen-breathe motion-reduce:animate-none"></div>
                <Image
                    src={Logo}
                    alt="Mini Arcade pixel-art cabinet"
                    width={300}
                    class="relative w-[min(58vw,15rem)] min-[801px]:w-[min(100%,18.5rem)] h-auto drop-shadow-[0_20px_28px_rgba(0,0,0,0.4)] -rotate-1"
                    loading="eager"
                />
            </div>

            <div>
                <p class="mb-[0.7rem] text-[#bda7cc] font-utility text-[0.7rem] font-semibold tracking-wider uppercase">A personal collection of browser games</p>
                <h1 id="hero-title" class="mb-4 text-white text-[clamp(3rem,17vw,4.4rem)] min-[501px]:text-[clamp(3.5rem,8vw,6.8rem)] font-[850] tracking-[-0.065em] leading-[0.9]">
                    Mini <span class="bg-[linear-gradient(100deg,#8f54ff_5%,#d26bd5_48%,#f4c430_100%)] bg-clip-text text-transparent">Arcade</span>
                </h1>
                <p class="max-w-[39rem] mb-[1.65rem] mx-auto min-[801px]:mx-0 text-arcade-muted text-[clamp(1rem,2vw,1.12rem)] leading-[1.7]">
                    A home for the little games I build while learning, testing ideas,
                    or following a curiosity too far. Pick one and play for a while.
                </p>

                <div class="flex flex-col min-[501px]:flex-row flex-wrap gap-[0.7rem] justify-center min-[801px]:justify-start">
                    <a href="#games" class="button">Choose a game</a>
                    <a href="/about" class="button button--secondary">About the project</a>
                </div>

                <dl class="grid w-full grid-cols-3 gap-0 m-0 mt-8 pt-5 border-t border-arcade-border">
                    <div class="grid min-w-0 gap-[0.15rem] pr-2 sm:pr-5">
                        <dt class="text-arcade-subtle font-utility text-[0.54rem] sm:text-[0.6rem] leading-tight tracking-wider uppercase">{gameStatuses.playable.label}</dt>
                        <dd class="m-0 text-white font-utility text-[0.9rem] font-semibold">{String(playableCount).padStart(2, "0")}</dd>
                    </div>
                    <div class="grid min-w-0 gap-[0.15rem] px-2 sm:px-5 border-l border-arcade-border">
                        <dt class="text-arcade-subtle font-utility text-[0.54rem] sm:text-[0.6rem] leading-tight tracking-wider uppercase">{gameStatuses["in-development"].label}</dt>
                        <dd class="m-0 text-white font-utility text-[0.9rem] font-semibold">{String(inDevelopmentCount).padStart(2, "0")}</dd>
                    </div>
                    <div class="grid min-w-0 gap-[0.15rem] pl-2 sm:pl-5 border-l border-arcade-border">
                        <dt class="text-arcade-subtle font-utility text-[0.54rem] sm:text-[0.6rem] leading-tight tracking-wider uppercase">Install</dt>
                        <dd class="m-0 text-white font-utility text-[0.9rem] font-semibold">None</dd>
                    </div>
                </dl>
            </div>
        </div>

        <div class="relative z-10 flex items-center justify-center gap-[0.6rem] py-[0.85rem] px-4 border-t border-arcade-border text-arcade-subtle bg-[rgba(7,5,11,0.32)] font-utility text-[0.62rem] tracking-wider uppercase">
            <span class="size-[0.42rem] rounded-full bg-arcade-green shadow-[0_0_10px_rgba(130,220,61,0.65)] animate-prompt-blink motion-reduce:animate-none" aria-hidden="true"></span>
            Scroll to select a game
            <span aria-hidden="true">↓</span>
        </div>
    </div>
</section>
