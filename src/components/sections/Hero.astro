---
import { Image } from "astro:assets"
import Logo from "@/images/logo.png"
import { gameStatuses, getGameCount } from "@/constants/games"

const playableCount = getGameCount("playable")
const inDevelopmentCount = getGameCount("in-development")
---

<section class="shell hero" aria-labelledby="hero-title">
    <div class="hero__screen">
        <div class="hero__screen-bar" aria-hidden="true">
            <span>MINI_ARCADE.EXE</span>
            <span class="screen-lights"><i></i><i></i><i></i></span>
        </div>

        <div class="hero__content">
            <div class="hero__logo-wrap">
                <div class="hero__glow"></div>
                <Image
                    src={Logo}
                    alt="Mini Arcade pixel-art cabinet"
                    width={300}
                    class="hero__logo"
                    loading="eager"
                />
            </div>

            <div class="hero__copy">
                <p class="hero__kicker">A personal collection of browser games</p>
                <h1 id="hero-title">Mini <span>Arcade</span></h1>
                <p class="hero__intro">
                    A home for the little games I build while learning, testing ideas,
                    or following a curiosity too far. Pick one and play for a while.
                </p>

                <div class="hero__actions">
                    <a href="#games" class="button">Choose a game</a>
                    <a href="/about" class="button button--secondary">About the project</a>
                </div>

                <dl class="hero__status">
                    <div><dt>{gameStatuses.playable.label}</dt><dd>{String(playableCount).padStart(2, "0")}</dd></div>
                    <div><dt>{gameStatuses["in-development"].label}</dt><dd>{String(inDevelopmentCount).padStart(2, "0")}</dd></div>
                    <div><dt>Install</dt><dd>None</dd></div>
                </dl>
            </div>
        </div>

        <div class="hero__prompt">
            <span class="prompt-dot" aria-hidden="true"></span>
            Scroll to select a game
            <span aria-hidden="true">↓</span>
        </div>
    </div>
</section>

<style>
    .hero {
        padding-block: clamp(2rem, 5vw, 4.5rem) clamp(3.5rem, 7vw, 6rem);
    }

    .hero__screen {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--arcade-border-bright);
        border-radius: 1.4rem;
        background:
            linear-gradient(135deg, rgba(35, 135, 196, 0.2), transparent 42%),
            radial-gradient(circle at 26% 47%, rgba(139, 44, 255, 0.18), transparent 24rem),
            #181222;
        box-shadow: 0 26px 80px rgba(0, 0, 0, 0.36);
    }

    .hero__screen::after {
        position: absolute;
        inset: 0;
        content: "";
        pointer-events: none;
        background: repeating-linear-gradient(
            0deg,
            transparent 0,
            transparent 3px,
            rgba(255, 255, 255, 0.018) 3px,
            rgba(255, 255, 255, 0.018) 4px
        );
        mix-blend-mode: screen;
    }

    .hero__screen-bar {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--arcade-border);
        color: var(--arcade-subtle);
        background: rgba(7, 5, 11, 0.35);
        font-family: var(--font-utility);
        font-size: 0.62rem;
        letter-spacing: 0.08em;
    }

    .screen-lights {
        display: flex;
        gap: 0.35rem;
    }

    .screen-lights i {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 50%;
        background: var(--arcade-red);
        box-shadow: 0 0 10px rgba(229, 69, 75, 0.55);
    }

    .screen-lights i:nth-child(2) {
        background: var(--arcade-yellow);
        box-shadow: 0 0 10px rgba(244, 196, 48, 0.55);
    }

    .screen-lights i:nth-child(3) {
        background: var(--arcade-green);
        box-shadow: 0 0 10px rgba(130, 220, 61, 0.55);
    }

    .hero__content {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(17rem, 0.8fr) minmax(0, 1.2fr);
        gap: clamp(2rem, 6vw, 6rem);
        align-items: center;
        min-height: clamp(31rem, 56vw, 39rem);
        padding: clamp(2rem, 6vw, 5rem);
    }

    .hero__logo-wrap {
        position: relative;
        display: grid;
        place-items: center;
    }

    .hero__glow {
        position: absolute;
        width: min(90%, 23rem);
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(244, 196, 48, 0.25), rgba(35, 135, 196, 0.09) 46%, transparent 70%);
        filter: blur(12px);
        animation: screen-breathe 4s ease-in-out infinite;
    }

    .hero__logo-wrap :global(.hero__logo) {
        position: relative;
        width: min(100%, 18.5rem);
        height: auto;
        filter: drop-shadow(0 20px 28px rgba(0, 0, 0, 0.4));
        transform: rotate(-1deg);
    }

    .hero__kicker {
        margin-bottom: 0.7rem;
        color: #bda7cc;
        font-family: var(--font-utility);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    h1 {
        margin-bottom: 1rem;
        color: #fff;
        font-size: clamp(3.5rem, 8vw, 6.8rem);
        font-weight: 850;
        letter-spacing: -0.065em;
        line-height: 0.9;
    }

    h1 span {
        color: transparent;
        background: linear-gradient(100deg, #8f54ff 5%, #d26bd5 48%, #f4c430 100%);
        background-clip: text;
        -webkit-background-clip: text;
    }

    .hero__intro {
        max-width: 39rem;
        margin-bottom: 1.65rem;
        color: var(--arcade-muted);
        font-size: clamp(1rem, 2vw, 1.12rem);
        line-height: 1.7;
    }

    .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
    }

    .hero__status {
        display: flex;
        flex-wrap: wrap;
        gap: 0;
        margin: 2rem 0 0;
        padding-top: 1.25rem;
        border-top: 1px solid var(--arcade-border);
    }

    .hero__status div {
        display: grid;
        min-width: 7rem;
        gap: 0.15rem;
        padding-right: 1.35rem;
    }

    .hero__status div + div {
        padding-left: 1.35rem;
        border-left: 1px solid var(--arcade-border);
    }

    .hero__status dt {
        color: var(--arcade-subtle);
        font-family: var(--font-utility);
        font-size: 0.6rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .hero__status dd {
        margin: 0;
        color: #fff;
        font-family: var(--font-utility);
        font-size: 0.9rem;
        font-weight: 600;
    }

    .hero__prompt {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        padding: 0.85rem 1rem;
        border-top: 1px solid var(--arcade-border);
        color: var(--arcade-subtle);
        background: rgba(7, 5, 11, 0.32);
        font-family: var(--font-utility);
        font-size: 0.62rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    .prompt-dot {
        width: 0.42rem;
        height: 0.42rem;
        border-radius: 50%;
        background: var(--arcade-green);
        box-shadow: 0 0 10px rgba(130, 220, 61, 0.65);
        animation: prompt-blink 1.3s steps(2) infinite;
    }

    @keyframes screen-breathe {
        50% { opacity: 0.72; transform: scale(0.96); }
    }

    @keyframes prompt-blink {
        50% { opacity: 0.25; }
    }

    @media (max-width: 800px) {
        .hero__content {
            grid-template-columns: 1fr;
            min-height: 0;
            text-align: center;
        }

        .hero__logo-wrap :global(.hero__logo) {
            width: min(58vw, 15rem);
        }

        .hero__intro {
            margin-inline: auto;
        }

        .hero__actions,
        .hero__status {
            justify-content: center;
        }
    }

    @media (max-width: 500px) {
        .hero__content {
            gap: 1.2rem;
            padding: 1.4rem;
        }

        h1 {
            font-size: clamp(3rem, 17vw, 4.4rem);
        }

        .hero__actions {
            flex-direction: column;
        }

        .hero__status div {
            min-width: 0;
            flex: 1;
            padding-right: 0.65rem;
        }

        .hero__status div + div {
            padding-left: 0.65rem;
        }
    }
</style>
