---
import Layout from "@/layouts/Layout.astro"
import Games from "@/components/sections/Games.astro"
import { getGameCount } from "@/constants/games"

const playableCount = getGameCount("playable")
const inDevelopmentCount = getGameCount("in-development")
---

<Layout title="Games" description="Browse every playable game and work-in-progress experiment in Mini Arcade.">
    <header class="shell page-intro catalog-intro">
        <div>
            <span class="eyebrow">Game select</span>
            <h1 class="display-type">Pick a game.</h1>
        </div>
        <p>
            {playableCount} are ready to play. {inDevelopmentCount} are honest
            works in progress, and each card tells you which is which.
        </p>
    </header>
    <Games showHeader={false} />
</Layout>

<style>
    .catalog-intro h1 {
        font-size: clamp(2.8rem, 7vw, 4.9rem);
    }
</style>
