---
import Layout from "@layouts/Layout.astro"
import LoginClient from "@components/sections/LoginClient"
---

<Layout title="Sign in" description="Sign in to your Mini Arcade player profile.">
    <section class="shell grid grid-cols-1 md:grid-cols-[minmax(0,0.8fr)_minmax(19rem,1fr)] gap-[clamp(2rem,7vw,6rem)] items-center max-w-[900px] py-[clamp(3.5rem,9vw,7rem)]">
        <header>
            <span class="eyebrow">Player access</span>
            <h1 class="display-type mb-3 text-[clamp(2.8rem,7vw,4.7rem)]">Sign in</h1>
            <p class="max-w-[30rem] text-arcade-muted text-[0.98rem]">Open the profile attached to the arcade experiments that support it.</p>
            <a href="/all-games" class="inline-flex min-h-11 items-center mt-5 text-arcade-subtle font-utility text-[0.7rem] transition-colors duration-150 hover:text-arcade-text">← Back to the games</a>
        </header>
        <LoginClient client:load />
    </section>
</Layout>
