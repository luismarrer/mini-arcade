---
import Layout from "@layouts/Layout.astro"
import LoginClient from "@components/sections/LoginClient"
---

<Layout title="Sign in" description="Sign in to your Mini Arcade player profile.">
    <section class="shell auth-page">
        <header>
            <span class="eyebrow">Player access</span>
            <h1 class="display-type">Sign in</h1>
            <p>Open the profile attached to the arcade experiments that support it.</p>
            <a href="/all-games" class="auth-back">← Back to the games</a>
        </header>
        <LoginClient client:load />
    </section>
</Layout>

<style>
    .auth-page {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(19rem, 1fr);
        gap: clamp(2rem, 7vw, 6rem);
        align-items: center;
        max-width: 900px;
        padding-block: clamp(3.5rem, 9vw, 7rem);
    }

    .auth-page h1 {
        margin-bottom: 0.8rem;
        font-size: clamp(2.8rem, 7vw, 4.7rem);
    }

    .auth-page header p {
        max-width: 30rem;
        color: var(--arcade-muted);
        font-size: 0.98rem;
    }

    .auth-back {
        display: inline-block;
        margin-top: 1.2rem;
        color: var(--arcade-subtle);
        font-family: var(--font-utility);
        font-size: 0.7rem;
        transition: color 160ms ease;
    }

    .auth-back:hover { color: var(--arcade-text); }

    @media (max-width: 760px) {
        .auth-page { grid-template-columns: 1fr; }
    }
</style>
