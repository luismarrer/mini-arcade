---
import Layout from "@/layouts/Layout.astro"
import GameShell from "@/components/GameShell.astro"
import MonkeytypeGame from "@/components/games/MonkeytypeGame.astro"
import { getGame } from "@/constants/games"

const game = getGame("monkeytype")!
---

<Layout title={game.title} description={game.description}>
    <GameShell {game}>
        <MonkeytypeGame />
    </GameShell>
</Layout>
