---
import Layout from "@layouts/Layout.astro"
import ProfileClient from "@components/sections/ProfileClient"
---

<Layout title="Player profile" description="View your Mini Arcade player profile.">
    <section class="shell max-w-[860px] py-[clamp(3.5rem,9vw,6rem)]">
        <header class="mb-7">
            <span class="eyebrow">Player profile</span>
            <h1 class="display-type mb-2.5 text-[clamp(2.8rem,7vw,4.6rem)]">Your profile</h1>
            <p class="mb-0 text-arcade-muted">Edit your player identity and review saved points and best scores.</p>
        </header>
        <ProfileClient client:load />
    </section>
</Layout>
