---
import Layout from "@layouts/Layout.astro"
import ProfileClient from "@components/sections/ProfileClient"
---

<Layout title="Player profile" description="View your Mini Arcade player profile.">
    <section class="shell profile-page">
        <header>
            <span class="eyebrow">Player profile</span>
            <h1 class="display-type">Your profile</h1>
            <p>Your nickname, avatar and the date you joined the arcade.</p>
        </header>
        <ProfileClient client:load />
    </section>
</Layout>

<style>
    .profile-page {
        max-width: 680px;
        padding-block: clamp(3.5rem, 9vw, 6rem);
    }

    .profile-page > header { margin-bottom: 1.8rem; }

    .profile-page h1 {
        margin-bottom: 0.65rem;
        font-size: clamp(2.8rem, 7vw, 4.6rem);
    }

    .profile-page header p {
        margin-bottom: 0;
        color: var(--arcade-muted);
    }
</style>
