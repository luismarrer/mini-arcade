---
import Layout from "@/layouts/Layout.astro"
import Form from "@/components/sections/Form.astro"
---

<Layout title="Create a profile" description="Create a Mini Arcade player profile.">
    <section class="shell grid grid-cols-1 md:grid-cols-[minmax(0,0.8fr)_minmax(19rem,1fr)] gap-[clamp(2rem,7vw,6rem)] items-start max-w-[900px] py-[clamp(3.5rem,9vw,7rem)]">
        <header>
            <span class="eyebrow">New player</span>
            <h1 class="display-type mb-3 text-[clamp(2.7rem,6vw,4.5rem)]">Create a profile</h1>
            <p class="max-w-[30rem] text-arcade-muted text-[0.98rem]">Choose a nickname and an avatar for the experiments that save player data.</p>
            <a href="/all-games" class="inline-flex min-h-11 items-center mt-5 text-arcade-subtle font-utility text-[0.7rem] transition-colors duration-150 hover:text-arcade-text">← Back to the games</a>
        </header>
        <Form />
    </section>
</Layout>
