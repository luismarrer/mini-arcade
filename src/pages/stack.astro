---
import Layout from "@/layouts/Layout.astro"
import GameShell from "@/components/GameShell.astro"
import StackGame from "@/components/games/StackGame.astro"
import { getGame } from "@/constants/games"

const game = getGame("stack")!
---

<Layout title={game.title} description={game.description}>
    <GameShell {game}>
        <StackGame />
    </GameShell>
</Layout>
